#!/usr/bin/swift
// tile-ghostty — Tile open Ghostty (+ ChatGPT/Codex) windows into a grid.
//
// Collects standard windows from Ghostty and the ChatGPT macOS app (Codex
// bundle) on the selected display and the current Mission Control Space, then
// tiles them. Windows on other virtual desktops are left alone.
//
// Pure Ghostty (or pure ChatGPT) uses a fixed grid by window count:
//
// 1 window    → 1×1 full visible frame
// 2 windows   → 1×2 halves (L, R)
// 3 windows   → 1×3 thirds (L, C, R)
// 4 windows   → 1×4 fourths (L → R)
// 5–6 windows → 2×3 sixths (row-major)
// 7–8 windows → 2×4 eighths (row-major)
// 9–12 windows → 3×4 twelfths (max 12; row-major)
//
// Mixed Ghostty + single Codex/ChatGPT (preferred layouts; Codex min ~480×600):
//
// total 2 (1G+1C) → side by side: Codex left half, Ghostty right half
// total 3 (2G+1C) → Codex left half (full height); right half: two Ghostty stacked
// total 4 (3G+1C) → Codex left half; right: top-right quarter one Ghostty,
//                   bottom-right two Ghostty side-by-side
// total 5 (4G+1C) → top: 2×2 Ghostty; bottom Codex full width
// total 6 (5G+1C) → 2×3 cells: Ghostty in five cells, Codex bottom-left
// total 7+        → bottom Codex full width; Ghostty gridForCount in remainder
//
// Multiple Codex windows still use a reserved strip (right preferred, else
// bottom) so each Codex cell can meet the min size.
//
// Uses macOS Accessibility + AppKit only (no Rectangle). Direct AX frame
// sets avoid the frontmost-window races that stacked tiles in the top-left
// and failed with System Events -10006 when tiling more than 4 windows.
//
// Env:
//   TILE_GHOSTTY_SETTLE         Seconds between window placements (default: 0.03)
//   TILE_CHATGPT_MIN_WIDTH      ChatGPT/Codex min width to reserve (default: 480)
//   TILE_CHATGPT_MIN_HEIGHT     ChatGPT/Codex min height to reserve (default: 600)

import AppKit
import ApplicationServices
import Darwin
import Foundation

/// HIServices SPI: AX element → CGWindowID. Used by Rectangle / Hammerspoon.
/// Resolved at runtime so a missing symbol does not fail the script load.
let axGetWindowFn: (@convention(c) (AXUIElement, UnsafeMutablePointer<CGWindowID>) -> Int32)? = {
    typealias Fn = @convention(c) (AXUIElement, UnsafeMutablePointer<CGWindowID>) -> Int32
    if let sym = dlsym(UnsafeMutableRawPointer(bitPattern: -2), "_AXUIElementGetWindow") {
        return unsafeBitCast(sym, to: Fn.self)
    }
    let paths = [
        "/System/Library/Frameworks/ApplicationServices.framework/Frameworks/HIServices.framework/HIServices",
        "/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices",
    ]
    for path in paths {
        if let handle = dlopen(path, RTLD_LAZY),
           let sym = dlsym(handle, "_AXUIElementGetWindow") {
            return unsafeBitCast(sym, to: Fn.self)
        }
    }
    return nil
}()

// MARK: - Target apps

/// An app whose standard windows participate in the shared tile grid.
struct TileTarget {
    /// Exact lowercased process / localized names to match.
    let names: Set<String>
    /// Bundle identifiers (exact, lowercased) or substrings that uniquely identify the app.
    let bundleMatchers: [String]
    /// Process name used to bring the app forward (System Events / AppKit).
    let activateName: String
    /// Sort key so Ghostty stays before ChatGPT when concatenating windows.
    let order: Int
}

let tileTargets: [TileTarget] = [
    TileTarget(
        names: ["ghostty"],
        bundleMatchers: ["com.mitchellh.ghostty", "ghostty"],
        activateName: "Ghostty",
        order: 0
    ),
    TileTarget(
        names: ["chatgpt"],
        // Official ChatGPT macOS app ships as com.openai.codex.
        bundleMatchers: ["com.openai.codex", "chatgpt"],
        activateName: "ChatGPT",
        order: 1
    ),
]

func targetMatching(name: String?, bundle: String?) -> TileTarget? {
    let n = (name ?? "").lowercased()
    let b = (bundle ?? "").lowercased()
    for t in tileTargets {
        if t.names.contains(n) {
            return t
        }
        for m in t.bundleMatchers {
            if m.contains(".") {
                if b == m { return t }
            } else if !b.isEmpty && b.contains(m) {
                return t
            }
        }
    }
    return nil
}

/// Skip Dock extras, XPC helpers, and other non-main processes.
func isMainGUIApp(_ app: NSRunningApplication) -> Bool {
    guard let bid = app.bundleIdentifier?.lowercased() else {
        // No bundle id: allow only if localized name is an exact target name.
        let n = (app.localizedName ?? "").lowercased()
        return tileTargets.contains { $0.names.contains(n) }
    }
    if bid.contains("dock.external") || bid.contains(".xpc") || bid.contains("helper") {
        return false
    }
    if bid.hasPrefix("com.apple.") && !tileTargets.contains(where: { t in
        t.bundleMatchers.contains { bid == $0 }
    }) {
        return false
    }
    return true
}

// MARK: - Helpers

func die(_ message: String) -> Never {
    fputs("tile-ghostty: \(message)\n", stderr)
    exit(1)
}

func settleDelay() {
    let raw = ProcessInfo.processInfo.environment["TILE_GHOSTTY_SETTLE"] ?? "0.03"
    let seconds = Double(raw) ?? 0.03
    if seconds > 0 {
        Thread.sleep(forTimeInterval: seconds)
    }
}

func axTrusted() -> Bool {
    let opts = [kAXTrustedCheckOptionPrompt.takeUnretainedValue() as String: true] as CFDictionary
    return AXIsProcessTrustedWithOptions(opts)
}

func axVisibleFrame(of screen: NSScreen, primary: NSScreen) -> CGRect {
    let v = screen.visibleFrame
    let p = primary.frame
    let primaryTop = p.origin.y + p.size.height
    // Convert AppKit bottom-left coords → Accessibility top-left coords.
    let axY = primaryTop - (v.origin.y + v.size.height)
    return CGRect(x: v.origin.x, y: axY, width: v.size.width, height: v.size.height)
}

func intersectionArea(_ a: CGRect, _ b: CGRect) -> CGFloat {
    let intersection = a.intersection(b)
    guard !intersection.isNull else { return 0 }
    return intersection.width * intersection.height
}

func screenContainingMost(of window: CGRect, primary: NSScreen) -> NSScreen? {
    NSScreen.screens.max {
        intersectionArea(window, axFrame(of: $0, primary: primary))
            < intersectionArea(window, axFrame(of: $1, primary: primary))
    }
}

func targetScreen() -> NSScreen {
    let screens = NSScreen.screens
    guard let primary = screens.first else {
        die("no screens available")
    }

    // A direct CLI invocation can retain a focused Ghostty/ChatGPT window.
    // Raycast commonly becomes frontmost itself, so its reliable selector is
    // the mouse location handled immediately below.
    if let frontmost = NSWorkspace.shared.frontmostApplication,
       targetMatching(name: frontmost.localizedName, bundle: frontmost.bundleIdentifier) != nil {
        let app = AXUIElementCreateApplication(frontmost.processIdentifier)
        var focusedRef: CFTypeRef?
        if AXUIElementCopyAttributeValue(
            app,
            kAXFocusedWindowAttribute as CFString,
            &focusedRef
        ) == .success,
           let focused = focusedRef,
           CFGetTypeID(focused) == AXUIElementGetTypeID() {
            let element = unsafeBitCast(focused, to: AXUIElement.self)
            if let origin = copyPoint(element, kAXPositionAttribute as String),
               let size = copySize(element, kAXSizeAttribute as String),
               let focusedScreen = screenContainingMost(
                   of: CGRect(origin: origin, size: size),
                   primary: primary
               ) {
                return focusedScreen
            }
        }
    }

    let mouse = NSEvent.mouseLocation
    for s in screens where s.frame.contains(mouse) {
        return s
    }
    return NSScreen.main ?? primary
}

func axFrame(of screen: NSScreen, primary: NSScreen) -> CGRect {
    let f = screen.frame
    let primaryTop = primary.frame.maxY
    return CGRect(
        x: f.minX,
        y: primaryTop - f.maxY,
        width: f.width,
        height: f.height
    )
}

/// Resolve running PIDs for every configured tile target (deduped).
func targetPIDs() -> [(pid: pid_t, target: TileTarget)] {
    var found: [pid_t: TileTarget] = [:]

    let opts: CGWindowListOption = [.optionOnScreenOnly, .excludeDesktopElements]
    if let info = CGWindowListCopyWindowInfo(opts, kCGNullWindowID) as? [[String: Any]] {
        for w in info {
            let owner = w[kCGWindowOwnerName as String] as? String
            guard let t = targetMatching(name: owner, bundle: nil) else { continue }
            if let pid = w[kCGWindowOwnerPID as String] as? pid_t {
                found[pid] = t
            }
        }
    }

    for app in NSWorkspace.shared.runningApplications {
        guard isMainGUIApp(app) else { continue }
        guard let t = targetMatching(name: app.localizedName, bundle: app.bundleIdentifier) else {
            continue
        }
        found[app.processIdentifier] = t
    }

    return found
        .map { (pid: $0.key, target: $0.value) }
        .sorted { a, b in
            if a.target.order != b.target.order {
                return a.target.order < b.target.order
            }
            return a.pid < b.pid
        }
}

func axValuePoint(_ point: CGPoint) -> AXValue {
    var p = point
    return AXValueCreate(.cgPoint, &p)!
}

func axValueSize(_ size: CGSize) -> AXValue {
    var s = size
    return AXValueCreate(.cgSize, &s)!
}

func copyPoint(_ element: AXUIElement, _ attr: String) -> CGPoint? {
    var ref: CFTypeRef?
    guard AXUIElementCopyAttributeValue(element, attr as CFString, &ref) == .success,
          let value = ref else { return nil }
    var point = CGPoint.zero
    guard AXValueGetValue(value as! AXValue, .cgPoint, &point) else { return nil }
    return point
}

func copySize(_ element: AXUIElement, _ attr: String) -> CGSize? {
    var ref: CFTypeRef?
    guard AXUIElementCopyAttributeValue(element, attr as CFString, &ref) == .success,
          let value = ref else { return nil }
    var size = CGSize.zero
    guard AXValueGetValue(value as! AXValue, .cgSize, &size) else { return nil }
    return size
}

func copyBool(_ element: AXUIElement, _ attr: String) -> Bool? {
    var ref: CFTypeRef?
    guard AXUIElementCopyAttributeValue(element, attr as CFString, &ref) == .success else {
        return nil
    }
    return (ref as? Bool)
}

/// A window participating in the shared tile grid, tagged with owning app.
struct TiledWindow {
    let element: AXUIElement
    let pid: pid_t
    let activateName: String
}

func windowFrame(_ element: AXUIElement) -> CGRect? {
    guard let origin = copyPoint(element, kAXPositionAttribute as String),
          let size = copySize(element, kAXSizeAttribute as String),
          size.width >= 50, size.height >= 50 else {
        return nil
    }
    return CGRect(origin: origin, size: size)
}

/// Assign a spanning window to the display containing the largest part of it.
func windowIsOnScreenRect(_ window: CGRect, screen: NSScreen, primary: NSScreen) -> Bool {
    let selectedFrame = axFrame(of: screen, primary: primary)
    let selectedArea = intersectionArea(window, selectedFrame)
    guard selectedArea > 0 else { return false }
    let largestArea = NSScreen.screens
        .map { intersectionArea(window, axFrame(of: $0, primary: primary)) }
        .max() ?? 0
    return selectedArea == largestArea
}

func windowIsOnScreen(_ element: AXUIElement, screen: NSScreen, primary: NSScreen) -> Bool {
    guard let window = windowFrame(element) else { return false }
    return windowIsOnScreenRect(window, screen: screen, primary: primary)
}

/// On-screen CG window (current Space on each display). Bounds are AX/Quartz
/// top-left, same as `kAXPosition` / `kAXSize`.
struct CGWindowSnap {
    let id: CGWindowID
    let pid: pid_t
    let bounds: CGRect
}

func onScreenCGWindows() -> [CGWindowSnap] {
    let opts: CGWindowListOption = [.optionOnScreenOnly, .excludeDesktopElements]
    guard let info = CGWindowListCopyWindowInfo(opts, kCGNullWindowID) as? [[String: Any]] else {
        return []
    }
    var result: [CGWindowSnap] = []
    for w in info {
        guard let pid = w[kCGWindowOwnerPID as String] as? pid_t else { continue }
        let layer = w[kCGWindowLayer as String] as? Int ?? 0
        guard layer == 0 else { continue }
        guard let num = w[kCGWindowNumber as String] as? NSNumber else { continue }
        let id = CGWindowID(truncating: num)
        guard id != 0 else { continue }
        guard let b = w[kCGWindowBounds as String] as? [String: Any],
              let x = b["X"] as? NSNumber,
              let y = b["Y"] as? NSNumber,
              let width = b["Width"] as? NSNumber,
              let height = b["Height"] as? NSNumber else { continue }
        let bounds = CGRect(
            x: x.doubleValue,
            y: y.doubleValue,
            width: width.doubleValue,
            height: height.doubleValue
        )
        guard bounds.width >= 50, bounds.height >= 50 else { continue }
        result.append(CGWindowSnap(id: id, pid: pid, bounds: bounds))
    }
    return result
}

func axWindowID(_ element: AXUIElement) -> CGWindowID? {
    guard let fn = axGetWindowFn else { return nil }
    var id: CGWindowID = 0
    let status = fn(element, &id)
    return status == 0 && id != 0 ? id : nil
}

func frameMatchScore(_ a: CGRect, _ b: CGRect) -> CGFloat {
    abs(a.minX - b.minX) + abs(a.minY - b.minY) + abs(a.width - b.width) + abs(a.height - b.height)
}

/// Raise in z-order only — do not steal key/main (that demotes sibling windows).
func raiseWindow(_ element: AXUIElement) {
    AXUIElementPerformAction(element, kAXRaiseAction as CFString)
}

func focusWindow(_ element: AXUIElement) {
    raiseWindow(element)
    AXUIElementSetAttributeValue(element, kAXMainAttribute as CFString, kCFBooleanTrue)
    AXUIElementSetAttributeValue(element, kAXFocusedAttribute as CFString, kCFBooleanTrue)
}

func setAppFrontmost(pid: pid_t) {
    let appEl = AXUIElementCreateApplication(pid)
    AXUIElementSetAttributeValue(appEl, kAXFrontmostAttribute as CFString, kCFBooleanTrue)
}

/// Bring `name` forward without `activateAllWindows` or AppleScript `activate`.
/// Those both switch to another Space when the app has windows there.
func activateApp(named name: String, running: NSRunningApplication?) {
    if let running {
        if #available(macOS 14.0, *) {
            running.activate(from: NSRunningApplication.current)
        } else {
            running.activate(options: [.activateIgnoringOtherApps])
        }
        setAppFrontmost(pid: running.processIdentifier)
        return
    }
    setProcessFrontmost(named: name)
}

func setProcessFrontmost(named name: String) {
    let escaped = name
        .replacingOccurrences(of: "\\", with: "\\\\")
        .replacingOccurrences(of: "\"", with: "\\\"")
    let proc = Process()
    proc.executableURL = URL(fileURLWithPath: "/usr/bin/osascript")
    proc.arguments = [
        "-e",
        "tell application \"System Events\" to if exists process \"\(escaped)\" then set frontmost of process \"\(escaped)\" to true",
    ]
    proc.standardOutput = FileHandle.nullDevice
    proc.standardError = FileHandle.nullDevice
    try? proc.run()
    proc.waitUntilExit()
}

/// Bring every tiled window above unrelated apps.
///
/// macOS has one key app. We activate **once per target app** (not once per
/// window). Raise and focus a tiled window on this Space *before* activation so
/// macOS does not switch to another virtual desktop. Finish on Ghostty when
/// present so mixed Ghostty + ChatGPT sets stay above non-target apps.
func bringTargetsForward(_ windows: [TiledWindow]) {
    guard !windows.isEmpty else { return }

    var appOrder: [(pid: pid_t, name: String)] = []
    var byPid: [pid_t: [AXUIElement]] = [:]
    for w in windows {
        if byPid[w.pid] == nil {
            appOrder.append((w.pid, w.activateName))
            byPid[w.pid] = []
        }
        byPid[w.pid, default: []].append(w.element)
    }

    func unminimizeAndRaise(_ el: AXUIElement) {
        if copyBool(el, kAXMinimizedAttribute as String) == true {
            AXUIElementSetAttributeValue(el, kAXMinimizedAttribute as CFString, kCFBooleanFalse)
        }
        if copyBool(el, "AXFullScreen") == true {
            AXUIElementSetAttributeValue(el, "AXFullScreen" as CFString, kCFBooleanFalse)
        }
        raiseWindow(el)
    }

    // Non-key apps first, Ghostty last (appOrder is Ghostty → ChatGPT by target.order).
    // Focus a current-Space tile first so activation does not follow a window
    // on Desktop 1. Activating Ghostty last leaves it key.
    for app in appOrder.reversed() {
        let els = byPid[app.pid] ?? []
        for el in els {
            unminimizeAndRaise(el)
        }
        if let key = els.last {
            focusWindow(key)
        }
        let running = NSRunningApplication(processIdentifier: app.pid)
        activateApp(named: app.name, running: running)
        Thread.sleep(forTimeInterval: 0.03)
    }

    // Pure z-order pass — no further activates (avoids per-window focus flicker).
    for w in windows {
        raiseWindow(w.element)
    }
}

/// Detached AppleScript written to a temp file (multi-line `-e` is fragile).
/// After Raycast/Terminal reclaim focus, set each target process frontmost.
/// Do not `tell application to activate` and do not loop every window: both
/// raise windows on other Spaces and switch the active virtual desktop.
func scheduleDeferredRaise(appNames: [String]) {
    guard !appNames.isEmpty else { return }

    // Prefer finishing on Ghostty when it contributed (matches pre-ChatGPT behavior).
    let orderedNames: [String] = {
        if appNames.contains("Ghostty") {
            return appNames.filter { $0 != "Ghostty" } + ["Ghostty"]
        }
        return appNames
    }()

    var lines: [String] = [
        "delay 0.25",
    ]
    for name in orderedNames {
        let escaped = name
            .replacingOccurrences(of: "\\", with: "\\\\")
            .replacingOccurrences(of: "\"", with: "\\\"")
        lines.append(contentsOf: [
            "tell application \"System Events\"",
            "  if exists process \"\(escaped)\" then set frontmost of process \"\(escaped)\" to true",
            "end tell",
            "delay 0.04",
        ])
    }

    let script = lines.joined(separator: "\n")
    let tmp = URL(fileURLWithPath: NSTemporaryDirectory())
        .appendingPathComponent("tile-ghostty-reraise-\(ProcessInfo.processInfo.processIdentifier).scpt.txt")
    do {
        try script.write(to: tmp, atomically: true, encoding: .utf8)
    } catch {
        let reActivate = Process()
        reActivate.executableURL = URL(fileURLWithPath: "/usr/bin/osascript")
        var args: [String] = ["-e", "delay 0.25"]
        for name in orderedNames {
            let escaped = name
                .replacingOccurrences(of: "\\", with: "\\\\")
                .replacingOccurrences(of: "\"", with: "\\\"")
            args.append(contentsOf: [
                "-e",
                "tell application \"System Events\" to if exists process \"\(escaped)\" then set frontmost of process \"\(escaped)\" to true",
            ])
            args.append(contentsOf: ["-e", "delay 0.05"])
        }
        reActivate.arguments = args
        reActivate.standardOutput = FileHandle.nullDevice
        reActivate.standardError = FileHandle.nullDevice
        try? reActivate.run()
        return
    }

    // Run: osascript file; then rm file (best-effort, in same shell).
    let reActivate = Process()
    reActivate.executableURL = URL(fileURLWithPath: "/bin/bash")
    let path = tmp.path.replacingOccurrences(of: "'", with: "'\\''")
    reActivate.arguments = [
        "-c",
        "/usr/bin/osascript '\(path)' >/dev/null 2>&1; rm -f '\(path)'",
    ]
    reActivate.standardOutput = FileHandle.nullDevice
    reActivate.standardError = FileHandle.nullDevice
    try? reActivate.run()
}

func setFrame(
    _ element: AXUIElement,
    origin: CGPoint,
    size: CGSize,
    /// Region this window may occupy (full display or a reserved/remainder rect).
    bounds: CGRect,
    pinToBottom: Bool
) -> Bool {
    // Exit fullscreen / unminimize if needed.
    if copyBool(element, kAXMinimizedAttribute as String) == true {
        AXUIElementSetAttributeValue(element, kAXMinimizedAttribute as CFString, kCFBooleanFalse)
    }
    if copyBool(element, "AXFullScreen") == true {
        AXUIElementSetAttributeValue(element, "AXFullScreen" as CFString, kCFBooleanFalse)
        Thread.sleep(forTimeInterval: 0.08)
    }

    // Try several set orders; some apps only honor one sequence.
    let attempts: [(CGPoint, CGSize)] = [
        (origin, size),
        (origin, size),
    ]

    for (idx, _) in attempts.enumerated() {
        if idx == 0 {
            AXUIElementSetAttributeValue(element, kAXPositionAttribute as CFString, axValuePoint(origin))
            AXUIElementSetAttributeValue(element, kAXSizeAttribute as CFString, axValueSize(size))
            AXUIElementSetAttributeValue(element, kAXSizeAttribute as CFString, axValueSize(size))
            AXUIElementSetAttributeValue(element, kAXPositionAttribute as CFString, axValuePoint(origin))
        } else {
            AXUIElementSetAttributeValue(element, kAXSizeAttribute as CFString, axValueSize(size))
            AXUIElementSetAttributeValue(element, kAXPositionAttribute as CFString, axValuePoint(origin))
            AXUIElementSetAttributeValue(element, kAXSizeAttribute as CFString, axValueSize(size))
        }

        // Apps can enforce a minimum size larger than the requested grid cell.
        // In particular, ChatGPT/Codex currently clamps below about 480×600.
        // Pin the final row to the *bounds* bottom using the actual height so
        // controls stay inside the reserved/remainder region (not over a sibling strip).
        // Repeat once because moving the window can cause AppKit to re-clamp it.
        var adjustedOrigin = origin
        for _ in 0..<2 {
            guard let actualSize = copySize(element, kAXSizeAttribute as String) else {
                break
            }
            let lowestAllowedY = bounds.maxY - actualSize.height
            let adjustedY = pinToBottom
                ? lowestAllowedY
                : min(adjustedOrigin.y, lowestAllowedY)
            adjustedOrigin.y = max(bounds.minY, adjustedY).rounded()
            // Also keep left edge from sliding past bounds when width clamps.
            let rightLimitX = bounds.maxX - actualSize.width
            adjustedOrigin.x = min(max(bounds.minX, adjustedOrigin.x), max(bounds.minX, rightLimitX)).rounded()
            AXUIElementSetAttributeValue(
                element,
                kAXPositionAttribute as CFString,
                axValuePoint(adjustedOrigin)
            )
        }

        // Verify roughly on-target (tolerance for window chrome rounding).
        // Some apps (e.g. ChatGPT) clamp size to a minimum; position still counts
        // as a successful tile when the frame origin landed.
        let pos = copyPoint(element, kAXPositionAttribute as String) ?? .zero
        let sz = copySize(element, kAXSizeAttribute as String) ?? .zero
        let posOK = abs(pos.x - adjustedOrigin.x) < 40
            && abs(pos.y - adjustedOrigin.y) < 40
        let sizeOK = abs(sz.width - size.width) < 80 && abs(sz.height - size.height) < 80
        let sizeClampedOK = posOK
            && sz.width >= 50 && sz.height >= 50
            && abs(sz.width - size.width) < 250
            && abs(sz.height - size.height) < 250
        if posOK && (sizeOK || sizeClampedOK) {
            // Raise only — focusing every window during placement buries siblings.
            raiseWindow(element)
            return true
        }
        Thread.sleep(forTimeInterval: 0.05)
    }
    return false
}

func standardWindows(pid: pid_t) -> [AXUIElement] {
    let app = AXUIElementCreateApplication(pid)
    var windowsRef: CFTypeRef?
    guard AXUIElementCopyAttributeValue(app, kAXWindowsAttribute as CFString, &windowsRef) == .success,
          let windows = windowsRef as? [AXUIElement] else {
        return []
    }

    var result: [AXUIElement] = []
    for win in windows {
        var roleRef: CFTypeRef?
        AXUIElementCopyAttributeValue(win, kAXRoleAttribute as CFString, &roleRef)
        let role = roleRef as? String ?? ""
        guard role == (kAXWindowRole as String) else { continue }

        var subroleRef: CFTypeRef?
        AXUIElementCopyAttributeValue(win, kAXSubroleAttribute as CFString, &subroleRef)
        let subrole = subroleRef as? String ?? ""
        // Accept standard windows; some builds omit subrole.
        if !subrole.isEmpty && subrole != (kAXStandardWindowSubrole as String) {
            continue
        }

        guard let size = copySize(win, kAXSizeAttribute as String),
              size.width >= 50, size.height >= 50 else {
            continue
        }
        result.append(win)
    }
    return result
}

/// AX windows that are on the current Space of `screen`.
///
/// AX lists windows on every Space; their frames still intersect the display.
/// `CGWindowList` `.optionOnScreenOnly` is the current Space. Match by
/// `CGWindowID` when HIServices provides it; otherwise pair each on-screen
/// CG window to at most one AX window by bounds.
func windowsOnCurrentSpace(
    pid: pid_t,
    screen: NSScreen,
    primary: NSScreen,
    onScreen: [CGWindowSnap]
) -> [AXUIElement] {
    let snaps = onScreen.filter { snap in
        snap.pid == pid && windowIsOnScreenRect(snap.bounds, screen: screen, primary: primary)
    }
    guard !snaps.isEmpty else { return [] }

    let candidates = standardWindows(pid: pid).filter {
        windowIsOnScreen($0, screen: screen, primary: primary)
    }
    guard !candidates.isEmpty else { return [] }

    var claimed = Set<CGWindowID>()
    var matched: [AXUIElement] = []
    var unmatchedAX: [AXUIElement] = []

    for el in candidates {
        if let wid = axWindowID(el) {
            if snaps.contains(where: { $0.id == wid }), claimed.insert(wid).inserted {
                matched.append(el)
            }
        } else {
            unmatchedAX.append(el)
        }
    }

    let matchLimit: CGFloat = 80
    for el in unmatchedAX {
        guard let frame = windowFrame(el) else { continue }
        var best: (id: CGWindowID, score: CGFloat)?
        for snap in snaps where !claimed.contains(snap.id) {
            let score = frameMatchScore(frame, snap.bounds)
            if score < matchLimit, best == nil || score < best!.score {
                best = (snap.id, score)
            }
        }
        if let best, claimed.insert(best.id).inserted {
            matched.append(el)
        }
    }
    return matched
}

// MARK: - Layout

struct GridSpec {
    let cols: Int
    let rows: Int
}

/// Fixed grid by window count (Ghostty and single-app ChatGPT).
func gridForCount(_ count: Int) -> GridSpec {
    switch count {
    case 1: return GridSpec(cols: 1, rows: 1)
    case 2: return GridSpec(cols: 2, rows: 1)
    case 3: return GridSpec(cols: 3, rows: 1)
    case 4: return GridSpec(cols: 4, rows: 1)
    case 5, 6: return GridSpec(cols: 3, rows: 2)
    case 7, 8: return GridSpec(cols: 4, rows: 2)
    default: return GridSpec(cols: 4, rows: 3) // 9+ → 3×4 (cap 12 at place time)
    }
}

func envCGFloat(_ key: String, default def: CGFloat) -> CGFloat {
    guard let raw = ProcessInfo.processInfo.environment[key],
          let value = Double(raw),
          value > 0 else {
        return def
    }
    return CGFloat(value)
}

/// ChatGPT/Codex enforces roughly 480×600 (measured). Overridable via env.
func chatGPTMinSize() -> CGSize {
    CGSize(
        width: envCGFloat("TILE_CHATGPT_MIN_WIDTH", default: 480),
        height: envCGFloat("TILE_CHATGPT_MIN_HEIGHT", default: 600)
    )
}

func isChatGPTWindow(_ window: TiledWindow) -> Bool {
    window.activateName == "ChatGPT"
}

struct PlaceResult {
    var ok = 0
    var fail = 0
    var tiled: [TiledWindow] = []
    var label = ""

    mutating func merge(_ other: PlaceResult) {
        ok += other.ok
        fail += other.fail
        tiled.append(contentsOf: other.tiled)
    }
}

/// Tile `windows` into `rect` with a row-major `cols`×`rows` grid (cap at cols*rows).
func placeWindowsInRect(
    _ windows: [TiledWindow],
    rect: CGRect,
    cols: Int,
    rows: Int,
    label: String
) -> PlaceResult {
    var result = PlaceResult()
    result.label = label
    let tileCount = min(windows.count, cols * rows)
    guard tileCount > 0, cols > 0, rows > 0, rect.width >= 50, rect.height >= 50 else {
        return result
    }

    let cellW = floor(rect.width / CGFloat(cols))
    let cellH = floor(rect.height / CGFloat(rows))

    for i in 0..<tileCount {
        let col = i % cols
        let row = i / cols

        let x = rect.minX + CGFloat(col) * cellW
        let y = rect.minY + CGFloat(row) * cellH
        let w = (col == cols - 1) ? (rect.maxX - x) : cellW
        let h = (row == rows - 1) ? (rect.maxY - y) : cellH

        let origin = CGPoint(x: x.rounded(), y: y.rounded())
        let size = CGSize(width: w.rounded(), height: h.rounded())
        let window = windows[i]

        // Pin/clamp inside `rect` so remainder grids do not spill into a ChatGPT strip.
        if setFrame(
            window.element,
            origin: origin,
            size: size,
            bounds: rect,
            pinToBottom: row == rows - 1
        ) {
            result.ok += 1
            result.tiled.append(window)
        } else {
            result.fail += 1
            fputs(
                "tile-ghostty: failed to place \(label) window \(i + 1) at \(Int(origin.x)),\(Int(origin.y)) \(Int(size.width))x\(Int(size.height))\n",
                stderr
            )
        }
        settleDelay()
    }
    return result
}

/// Place windows at explicit cell rects (for asymmetric mixed layouts).
/// `clampBounds` limits AX size-clamp drift; defaults to each cell.
func placeWindowsAtCells(
    _ items: [(window: TiledWindow, cell: CGRect, pinToBottom: Bool)],
    label: String,
    clampBounds: CGRect? = nil
) -> PlaceResult {
    var result = PlaceResult()
    result.label = label
    for (i, item) in items.enumerated() {
        let cell = item.cell
        guard cell.width >= 50, cell.height >= 50 else {
            result.fail += 1
            continue
        }
        let origin = CGPoint(x: cell.minX.rounded(), y: cell.minY.rounded())
        let size = CGSize(width: cell.width.rounded(), height: cell.height.rounded())
        let bounds = clampBounds ?? cell
        if setFrame(
            item.window.element,
            origin: origin,
            size: size,
            bounds: bounds,
            pinToBottom: item.pinToBottom
        ) {
            result.ok += 1
            result.tiled.append(item.window)
        } else {
            result.fail += 1
            fputs(
                "tile-ghostty: failed to place \(label) window \(i + 1) at \(Int(origin.x)),\(Int(origin.y)) \(Int(size.width))x\(Int(size.height))\n",
                stderr
            )
        }
        settleDelay()
    }
    return result
}

/// Left Codex strip width: at least minW, prefer ~half the display, leave room for Ghostty.
func leftCodexStripWidth(frame: CGRect, minW: CGFloat, preferredFraction: CGFloat = 0.5) -> CGFloat {
    let ghostFloor: CGFloat = 80
    var stripW = max(minW, floor(frame.width * preferredFraction))
    if frame.width - stripW < ghostFloor, frame.width > minW + ghostFloor {
        stripW = frame.width - ghostFloor
    }
    stripW = max(stripW, minW)
    stripW = min(stripW, frame.width)
    return stripW
}

/// Split `frame` into a full-height left Codex band and a right Ghostty remainder.
func leftCodexSplit(frame: CGRect, minW: CGFloat, minH: CGFloat, preferredFraction: CGFloat = 0.5) -> (chat: CGRect, ghostty: CGRect)? {
    guard frame.width + 0.5 >= minW, frame.height + 0.5 >= minH else { return nil }
    let stripW = leftCodexStripWidth(frame: frame, minW: minW, preferredFraction: preferredFraction)
    guard stripW > 0, stripW <= frame.width + 0.5 else { return nil }
    let chat = CGRect(
        x: frame.minX,
        y: frame.minY,
        width: stripW,
        height: frame.height
    )
    let ghostty = CGRect(
        x: frame.minX + stripW,
        y: frame.minY,
        width: max(0, frame.width - stripW),
        height: frame.height
    )
    return (chat, ghostty)
}

/// Bottom Codex strip height: at least minH, prefer ~half the display, leave room for Ghostty.
func bottomCodexStripHeight(frame: CGRect, minH: CGFloat, preferredFraction: CGFloat = 0.5) -> CGFloat {
    let ghostFloor: CGFloat = 80
    var stripH = max(minH, floor(frame.height * preferredFraction))
    if frame.height - stripH < ghostFloor, frame.height > minH + ghostFloor {
        stripH = frame.height - ghostFloor
    }
    stripH = max(stripH, minH)
    stripH = min(stripH, frame.height)
    return stripH
}

/// Split `frame` into a full-width bottom Codex band and a top Ghostty remainder.
func bottomCodexSplit(frame: CGRect, minH: CGFloat, preferredFraction: CGFloat = 0.5) -> (chat: CGRect, ghostty: CGRect)? {
    guard frame.height + 0.5 >= minH else { return nil }
    let stripH = bottomCodexStripHeight(frame: frame, minH: minH, preferredFraction: preferredFraction)
    guard stripH > 0, stripH <= frame.height + 0.5 else { return nil }
    let chat = CGRect(
        x: frame.minX,
        y: frame.maxY - stripH,
        width: frame.width,
        height: stripH
    )
    let ghostty = CGRect(
        x: frame.minX,
        y: frame.minY,
        width: frame.width,
        height: max(0, frame.height - stripH)
    )
    return (chat, ghostty)
}

/// 3 Ghostty in the right half (total=4): top-right quarter one pane; bottom-right two side-by-side.
func placeGhosttyTopQuarterBottomPair(_ windows: [TiledWindow], rect: CGRect) -> PlaceResult {
    guard windows.count >= 3, rect.width >= 50, rect.height >= 50 else {
        return placeWindowsInRect(windows, rect: rect, cols: 1, rows: 1, label: "Ghostty")
    }
    let topH = floor(rect.height / 2)
    let botH = rect.height - topH
    let botLeftW = floor(rect.width / 2)
    let botRightW = rect.width - botLeftW
    let top = CGRect(x: rect.minX, y: rect.minY, width: rect.width, height: topH)
    let botLeft = CGRect(x: rect.minX, y: rect.minY + topH, width: botLeftW, height: botH)
    let botRight = CGRect(x: rect.minX + botLeftW, y: rect.minY + topH, width: botRightW, height: botH)
    return placeWindowsAtCells(
        [
            (windows[0], top, false),
            (windows[1], botLeft, true),
            (windows[2], botRight, true),
        ],
        label: "Ghostty",
        clampBounds: rect
    )
}

/// Place Codex in `chatRect` and return a merged place result.
func placeCodexCell(_ chat: TiledWindow, rect: CGRect) -> PlaceResult {
    placeWindowsAtCells(
        [(chat, rect, true)],
        label: "ChatGPT",
        clampBounds: rect
    )
}

/// Mixed layout for exactly one Codex/ChatGPT window + N Ghostty (totals 2–6+).
/// Returns nil when the display cannot host Codex at min size (caller falls back).
func placeSingleCodexMixed(
    frame: CGRect,
    ghosttyWindows: [TiledWindow],
    chatWindows: [TiledWindow],
    minSize: CGSize
) -> (place: PlaceResult, note: String)? {
    guard chatWindows.count == 1 else { return nil }
    let chat = chatWindows[0]
    let ghostN = ghosttyWindows.count
    let minW = minSize.width
    let minH = minSize.height

    guard frame.height + 0.5 >= minH, frame.width + 0.5 >= minW else { return nil }

    // --- totals 2–4: Codex left half (full height); Ghostty on the right ---
    if ghostN >= 1, ghostN <= 3 {
        guard let split = leftCodexSplit(frame: frame, minW: minW, minH: minH) else {
            return nil
        }
        guard split.chat.width + 0.5 >= minW, split.chat.height + 0.5 >= minH else {
            return nil
        }

        var place = PlaceResult()
        place.merge(placeCodexCell(chat, rect: split.chat))

        let gRect = split.ghostty
        var gNote = "ghostty:empty"
        if gRect.width >= 50, gRect.height >= 50 {
            switch ghostN {
            case 1:
                // total 2: side by side
                place.merge(placeWindowsInRect(ghosttyWindows, rect: gRect, cols: 1, rows: 1, label: "Ghostty"))
                gNote = "ghostty:right-full"
            case 2:
                // total 3: two Ghostty stacked in the right half
                place.merge(placeWindowsInRect(ghosttyWindows, rect: gRect, cols: 1, rows: 2, label: "Ghostty"))
                gNote = "ghostty:right-stack2"
            default:
                // total 4: top-right quarter + bottom-right pair
                place.merge(placeGhosttyTopQuarterBottomPair(ghosttyWindows, rect: gRect))
                gNote = "ghostty:tr-quarter+br-pair"
            }
        }

        let note =
            "single-codex:left-strip"
            + " chat:\(Int(split.chat.width))x\(Int(split.chat.height))"
            + " \(gNote)"
            + " remainder:\(Int(gRect.width))x\(Int(gRect.height))"
        return (place, note)
    }

    // --- total 6 (5 Ghostty + 1 Codex): 2×3 cells, Codex bottom-left ---
    if ghostN == 5 {
        var bottomH = max(minH, floor(frame.height / 3))
        let topMin: CGFloat = 100
        if frame.height - bottomH < topMin, frame.height > minH + topMin {
            bottomH = frame.height - topMin
        }
        bottomH = max(bottomH, minH)
        bottomH = min(bottomH, frame.height)

        var codexW = floor(frame.width / 2)
        if codexW + 0.5 < minW {
            codexW = min(minW, frame.width)
        }
        let ghostBotW = frame.width - codexW
        let topH = frame.height - bottomH
        let topRect = CGRect(x: frame.minX, y: frame.minY, width: frame.width, height: topH)
        let codexCell = CGRect(
            x: frame.minX,
            y: frame.maxY - bottomH,
            width: codexW,
            height: bottomH
        )
        let ghostBotCell = CGRect(
            x: frame.minX + codexW,
            y: frame.maxY - bottomH,
            width: ghostBotW,
            height: bottomH
        )

        var place = PlaceResult()
        place.merge(placeCodexCell(chat, rect: codexCell))

        if topH >= 50, ghosttyWindows.count >= 4 {
            place.merge(placeWindowsInRect(
                Array(ghosttyWindows.prefix(4)),
                rect: topRect,
                cols: 2,
                rows: 2,
                label: "Ghostty"
            ))
        }
        if ghostBotW >= 50, ghosttyWindows.count >= 5 {
            place.merge(placeWindowsAtCells(
                [(ghosttyWindows[4], ghostBotCell, true)],
                label: "Ghostty",
                clampBounds: ghostBotCell
            ))
        }

        let note =
            "single-codex:2x3-codex-bl"
            + " chat:\(Int(codexCell.width))x\(Int(codexCell.height))"
            + " top:\(Int(topRect.width))x\(Int(topRect.height))"
        return (place, note)
    }

    // --- totals 5 and 7+: full-width bottom Codex, Ghostty in top remainder ---
    guard let split = bottomCodexSplit(frame: frame, minH: minH, preferredFraction: 0.5) else {
        return nil
    }
    guard split.chat.height + 0.5 >= minH, split.chat.width + 0.5 >= minW else {
        return nil
    }

    var place = PlaceResult()
    place.merge(placeWindowsInRect(
        chatWindows,
        rect: split.chat,
        cols: 1,
        rows: 1,
        label: "ChatGPT"
    ))

    let gRect = split.ghostty
    var gNote = "ghostty:empty"
    if ghostN > 0, gRect.width >= 50, gRect.height >= 50 {
        switch ghostN {
        case 4:
            place.merge(placeWindowsInRect(ghosttyWindows, rect: gRect, cols: 2, rows: 2, label: "Ghostty"))
            gNote = "ghostty:2x2"
        default:
            let grid = gridForCount(ghostN)
            place.merge(placeWindowsInRect(
                ghosttyWindows,
                rect: gRect,
                cols: grid.cols,
                rows: grid.rows,
                label: "Ghostty"
            ))
            gNote = "ghostty-grid:\(grid.cols)x\(grid.rows)"
        }
    }

    let note =
        "single-codex:bottom-strip"
        + " chat:\(Int(split.chat.width))x\(Int(split.chat.height))"
        + " \(gNote)"
        + " remainder:\(Int(gRect.width))x\(Int(gRect.height))"
    return (place, note)
}

/// Prefer full-height columns, then full-width rows, then best-fit for min size.
func chatGrid(count: Int, rect: CGRect, minSize: CGSize) -> GridSpec {
    let n = max(1, min(count, 12))
    if CGFloat(n) * minSize.width <= rect.width + 0.5, rect.height + 0.5 >= minSize.height {
        return GridSpec(cols: n, rows: 1)
    }
    if CGFloat(n) * minSize.height <= rect.height + 0.5, rect.width + 0.5 >= minSize.width {
        return GridSpec(cols: 1, rows: n)
    }

    var best = gridForCount(n)
    var bestScore: CGFloat = -1
    for cols in 1...n {
        let rows = (n + cols - 1) / cols
        let cellW = rect.width / CGFloat(cols)
        let cellH = rect.height / CGFloat(rows)
        let meets = cellW + 0.5 >= minSize.width && cellH + 0.5 >= minSize.height
        let score = (meets ? 1_000_000 : 0) as CGFloat + cellW * cellH
        if score > bestScore {
            bestScore = score
            best = GridSpec(cols: cols, rows: rows)
        }
    }
    return best
}

struct ReservedLayout {
    let chatRect: CGRect
    let remainder: CGRect
    let chatCols: Int
    let chatRows: Int
}

/// Reserve a contiguous region for ChatGPT that respects min size; remainder is for Ghostty.
func reserveChatGPTRegion(
    frame: CGRect,
    chatCount: Int,
    ghosttyCount: Int,
    minSize: CGSize
) -> ReservedLayout {
    let chatN = max(1, chatCount)
    let ghostN = ghosttyCount
    let minW = minSize.width
    let minH = minSize.height

    if ghostN == 0 {
        let grid = chatGrid(count: chatN, rect: frame, minSize: minSize)
        return ReservedLayout(
            chatRect: frame,
            remainder: .null,
            chatCols: grid.cols,
            chatRows: grid.rows
        )
    }

    // Prefer a right strip (ChatGPT as sidebar). Stack vertically when each row can be ≥ minH.
    let canStack = frame.height / CGFloat(chatN) + 0.5 >= minH
    if canStack {
        let fair = floor(frame.width / CGFloat(ghostN + 1))
        var stripW = max(minW, fair)
        // Keep a usable Ghostty region when the display is wide enough.
        let ghostFloor = min(frame.width * 0.4, frame.width - minW)
        if ghostFloor >= 200 {
            stripW = min(stripW, frame.width - ghostFloor)
            stripW = max(stripW, minW)
        }
        if stripW <= frame.width - 80 {
            let chatRect = CGRect(
                x: frame.maxX - stripW,
                y: frame.minY,
                width: stripW,
                height: frame.height
            )
            let remainder = CGRect(
                x: frame.minX,
                y: frame.minY,
                width: frame.width - stripW,
                height: frame.height
            )
            return ReservedLayout(
                chatRect: chatRect,
                remainder: remainder,
                chatCols: 1,
                chatRows: chatN
            )
        }
    }

    // Side-by-side ChatGPT panes in a wider right strip (when stacking is too short).
    let sideBySideMinW = minW * CGFloat(chatN)
    if sideBySideMinW <= frame.width - 200, frame.height + 0.5 >= minH {
        let fair = floor(frame.width * CGFloat(chatN) / CGFloat(chatN + max(ghostN, 1)))
        var stripW = max(sideBySideMinW, fair)
        let ghostFloor = min(frame.width * 0.35, frame.width - sideBySideMinW)
        if ghostFloor >= 150 {
            stripW = min(stripW, frame.width - ghostFloor)
            stripW = max(stripW, sideBySideMinW)
        }
        if stripW <= frame.width - 80 {
            let chatRect = CGRect(
                x: frame.maxX - stripW,
                y: frame.minY,
                width: stripW,
                height: frame.height
            )
            let remainder = CGRect(
                x: frame.minX,
                y: frame.minY,
                width: frame.width - stripW,
                height: frame.height
            )
            return ReservedLayout(
                chatRect: chatRect,
                remainder: remainder,
                chatCols: chatN,
                chatRows: 1
            )
        }
    }

    // Bottom strip: full width, height ≥ minH; ChatGPT tiles inside it.
    var stripH = max(minH, floor(frame.height / 2))
    if ghostN > 0 {
        stripH = min(stripH, max(minH, floor(frame.height * 0.5)))
        stripH = max(stripH, minH)
    }
    if stripH <= frame.height - 80 {
        let chatRect = CGRect(
            x: frame.minX,
            y: frame.maxY - stripH,
            width: frame.width,
            height: stripH
        )
        let remainder = CGRect(
            x: frame.minX,
            y: frame.minY,
            width: frame.width,
            height: frame.height - stripH
        )
        let grid = chatGrid(count: chatN, rect: chatRect, minSize: minSize)
        return ReservedLayout(
            chatRect: chatRect,
            remainder: remainder,
            chatCols: grid.cols,
            chatRows: grid.rows
        )
    }

    // Last resort: min-width right strip (may leave a narrow Ghostty band).
    let stripW = min(max(minW, 1), frame.width)
    let chatRect = CGRect(
        x: frame.maxX - stripW,
        y: frame.minY,
        width: stripW,
        height: frame.height
    )
    let remainder = CGRect(
        x: frame.minX,
        y: frame.minY,
        width: max(0, frame.width - stripW),
        height: frame.height
    )
    let grid = chatGrid(count: chatN, rect: chatRect, minSize: minSize)
    return ReservedLayout(
        chatRect: chatRect,
        remainder: remainder,
        chatCols: grid.cols,
        chatRows: grid.rows
    )
}

// MARK: - Main

if !axTrusted() {
    die("Accessibility permission required. Enable this host (Shortcuts/Terminal) in System Settings → Privacy & Security → Accessibility, then re-run.")
}

let apps = targetPIDs()
if apps.isEmpty {
    // Nothing to do.
    exit(0)
}

// Capture the destination before any app is brought forward. This matters for
// Raycast, whose silent command can briefly change the frontmost application.
let screen = targetScreen()
guard let primary = NSScreen.screens.first else {
    die("no screens available")
}
let frame = axVisibleFrame(of: screen, primary: primary)

// Capture the current Space before any activation. Activating an app with
// windows on Desktop 1 would switch Spaces and then we would tile that Space.
let onScreen = onScreenCGWindows()

// Ghostty windows first, then ChatGPT — each app in AX order.
// Only windows on this display's current Space participate.
var windows: [TiledWindow] = []
for e in apps {
    for el in windowsOnCurrentSpace(
        pid: e.pid,
        screen: screen,
        primary: primary,
        onScreen: onScreen
    ) {
        windows.append(TiledWindow(
            element: el,
            pid: e.pid,
            activateName: e.target.activateName
        ))
    }
}

if windows.isEmpty {
    exit(0)
}

let ghosttyWindows = windows.filter { !isChatGPTWindow($0) }
let chatWindows = windows.filter { isChatGPTWindow($0) }
let minChat = chatGPTMinSize()

var place = PlaceResult()
var layoutNote = ""

if chatWindows.isEmpty {
    // Pure Ghostty: existing shared grid.
    let grid = gridForCount(ghosttyWindows.count)
    place = placeWindowsInRect(
        ghosttyWindows,
        rect: frame,
        cols: grid.cols,
        rows: grid.rows,
        label: "Ghostty"
    )
    layoutNote = "grid:\(grid.cols)x\(grid.rows)"
} else if ghosttyWindows.isEmpty {
    // Pure ChatGPT: grid biased to satisfy min width/height.
    let grid = chatGrid(count: chatWindows.count, rect: frame, minSize: minChat)
    place = placeWindowsInRect(
        chatWindows,
        rect: frame,
        cols: grid.cols,
        rows: grid.rows,
        label: "ChatGPT"
    )
    layoutNote = "chatgpt-grid:\(grid.cols)x\(grid.rows) min:\(Int(minChat.width))x\(Int(minChat.height))"
} else if chatWindows.count == 1,
          let mixed = placeSingleCodexMixed(
              frame: frame,
              ghosttyWindows: ghosttyWindows,
              chatWindows: chatWindows,
              minSize: minChat
          ) {
    // Single Codex/ChatGPT: left-strip (2–4) or bottom-band (5+) mixed layouts.
    place = mixed.place
    layoutNote = mixed.note
} else {
    // Multiple Codex windows (or single-Codex fallback): reserve strip, then Ghostty grid.
    let reserved = reserveChatGPTRegion(
        frame: frame,
        chatCount: chatWindows.count,
        ghosttyCount: ghosttyWindows.count,
        minSize: minChat
    )

    let chatPlace = placeWindowsInRect(
        chatWindows,
        rect: reserved.chatRect,
        cols: reserved.chatCols,
        rows: reserved.chatRows,
        label: "ChatGPT"
    )
    place.merge(chatPlace)

    if !reserved.remainder.isNull, reserved.remainder.width >= 50, reserved.remainder.height >= 50 {
        let gGrid = gridForCount(ghosttyWindows.count)
        let ghostPlace = placeWindowsInRect(
            ghosttyWindows,
            rect: reserved.remainder,
            cols: gGrid.cols,
            rows: gGrid.rows,
            label: "Ghostty"
        )
        place.merge(ghostPlace)
        layoutNote =
            "chatgpt:\(Int(reserved.chatRect.width))x\(Int(reserved.chatRect.height))"
            + "@\(Int(reserved.chatRect.minX)),\(Int(reserved.chatRect.minY))"
            + " \(reserved.chatCols)x\(reserved.chatRows)"
            + " ghostty-grid:\(gGrid.cols)x\(gGrid.rows)"
            + " remainder:\(Int(reserved.remainder.width))x\(Int(reserved.remainder.height))"
    } else {
        layoutNote =
            "chatgpt-only-reserved:\(Int(reserved.chatRect.width))x\(Int(reserved.chatRect.height))"
    }
}

let tiledWindows = place.tiled
let ok = place.ok
let fail = place.fail
let tileCount = ok + fail

if ok == 0 {
    die("failed to place any of \(max(tileCount, windows.count)) windows")
}

if fail > 0 {
    fputs(
        "tile-ghostty: partial success — tiled:\(ok)/\(tileCount) \(layoutNote) fails:\(fail)\n",
        stderr
    )
}

// Raise every tiled window above non-target apps (multi-app aware).
// Order: Ghostty first in list still OK — bringTargetsForward activates ChatGPT then Ghostty.
bringTargetsForward(tiledWindows)

// Detached frontmost after this process exits. Raycast/Terminal/Shortcuts often
// reclaim focus when the script ends; restore Ghostty + ChatGPT without a Space switch.
var appNames: [String] = []
var seenNames = Set<String>()
for w in tiledWindows {
    if seenNames.insert(w.activateName).inserted {
        appNames.append(w.activateName)
    }
}
scheduleDeferredRaise(appNames: appNames)

exit(0)
